{
  "name": "Dashboard Company Azure",
  "dataColors": ["#1F4E79", "#2E86C1", "#48C9B0", "#F5B041", "#AF7AC5", "#EC7063", "#5D6D7E", "#58D68D"],
  "background": "#FFFFFF",
  "foreground": "#1B2631",
  "tableAccent": "#1F4E79",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 13, "color": "#1B2631" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#1B2631" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#34495E" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 28, "color": "#1F4E79" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#EEF2F7" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#D6DEE8" } }, "radius": 10 }],
        "dropShadow": [{ "show": true, "preset": "BottomRight" }],
        "padding": [{ "top": 10, "bottom": 10, "left": 12, "right": 12 }]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [{ "backColor": { "solid": { "color": "#1F4E79" } }, "fontColor": { "solid": { "color": "#FFFFFF" } }, "bold": true }],
        "values": [{ "backColorPrimary": { "solid": { "color": "#FFFFFF" } }, "backColorSecondary": { "solid": { "color": "#F4F7FB" } } }]
      }
    },
    "textbox": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }],
        "dropShadow": [{ "show": false }]
      }
    }
  }
}
